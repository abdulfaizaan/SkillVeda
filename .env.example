# SkillVeda local configuration. Copy to .env and edit. Keys stay backend-only.

# Optional LLM explanations: disabled | openai_compatible | ollama | gemini
LLM_PROVIDER=disabled
LLM_MODEL=
LLM_API_KEY=
LLM_BASE_URL=
LLM_TIMEOUT_SECONDS=20

# Local SQLite store (default: .local/skillveda.db)
SKILLVEDA_DB_PATH=

# Comma-separated allowed frontend origins
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
